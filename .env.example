# Deep Research - Environment Configuration
# Copy this file to .env and modify as needed

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
RESEARCH_MODEL=dolphin3:8b

# Tor Configuration (auto-managed if not running)
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
TOR_CONTROL_PORT=9051

# Research Defaults
MAX_SOURCES=30
MAX_SUB_QUERIES=5
CONTENT_TRUNCATE_CHARS=15000
